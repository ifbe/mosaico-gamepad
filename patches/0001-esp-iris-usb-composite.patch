+ * SPDX-License-Identifier: Apache-2.0
+ */
+#pragma once
+
+#include <stddef.h>
+#include <stdint.h>
+
+#include "esp_err.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/** One application-owned HID interface appended to the ESP-Iris USB device.
+ *
+ * Iris keeps its own CDC interfaces; these descriptors are composed after
+ * them. All fields are borrowed/copied at registration time and the report
+ * descriptor must stay valid for the lifetime of the USB driver. */
+typedef struct {
+    const uint8_t *report_desc; /* HID report descriptor bytes */
+    uint16_t report_desc_len;   /* byte length of report_desc */
+    uint8_t ep_in;              /* IN endpoint address, e.g. 0x85 */
+    uint8_t ep_size;            /* endpoint max packet size (8 or 64) */
+    uint8_t interval_ms;        /* polling interval in milliseconds */
+} esp_iris_usb_hid_iface_t;
+
+/** Largest number of HID interfaces the composite device can carry. */
+#define ESP_IRIS_USB_HID_MAX 4
+
+/** Register the HID interfaces appended to the ESP-Iris USB device.
+ *
+ * Call before the ESP-Iris USB transport starts (before app_main work that
+ * boots Iris). The table is copied; appending supports at most
+ * ESP_IRIS_USB_HID_MAX entries and cannot exceed CONFIG_TINYUSB_HID_COUNT.
+ * The report descriptor a host fetches comes from the application's
+ * tud_hid_descriptor_report_cb() instance index, which must match this order.
+ */
+esp_err_t esp_iris_usb_set_hid_ifaces(const esp_iris_usb_hid_iface_t *ifaces,
+                                      size_t count);
+
+
+/** First interface number available to application interfaces. Iris always owns
+ * the low numbers for its CDC pairs; build a class-specific descriptor block
+ * against this base and pass it to esp_iris_usb_set_extra_interfaces(). */
+uint8_t esp_iris_usb_first_free_interface(void);
+
+/** Override the USB vendor/product IDs of the composite device.
+ *
+ * Must run before ESP-Iris installs the USB driver (before esp_iris_boot_probe).
+ * Some host software identifies a product by VID/PID only, so an application
+ * may need a different identity than the Espressif development default. */
+esp_err_t esp_iris_usb_set_ids(uint16_t vid, uint16_t pid);
+
+/** Append a complete application interface block (for example USB Audio).
+ *
+ * The bytes are copied and inserted verbatim after Iris' CDC interfaces and
+ * before any registered HID interface. @p interface_count is the number of
+ * standard interface descriptors contained in the block; it must match the
+ * interface numbers computed from esp_iris_usb_first_free_interface().
+ * Passing len == 0 removes a previously registered block. */
+esp_err_t esp_iris_usb_set_extra_interfaces(const uint8_t *desc, size_t len,
+                                            uint8_t interface_count);
+
+#ifdef __cplusplus
+}
+#endif
