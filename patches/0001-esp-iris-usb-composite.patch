+/* Optional composite HID interfaces for applications whose product function
+ * needs USB HID (a gamepad, a mouse, a keyboard). The application registers
+ * its interfaces before Iris starts; Iris keeps its own CDC interfaces, so
+ * device operations and recovery stay on the same cable. Descriptors are
+ * composed at runtime because the application may disable classes at boot. */
+/* Optional application descriptor block (a complete class-specific interface
+ * set, for example USB Audio). Iris appends it verbatim after its CDC pairs and
+ * before any HID interface, so the application builds it against the interface
+ * number reported by esp_iris_usb_first_free_interface(). */
+#define ESP_IRIS_USB_EXTRA_MAX_BYTES 768
+#define ESP_IRIS_USB_EXTRA_MAX_IFACES 8
+
+static uint8_t s_extra_desc[ESP_IRIS_USB_EXTRA_MAX_BYTES];
+static size_t s_extra_len;
+static uint8_t s_extra_ifaces;
+
+esp_err_t esp_iris_usb_set_extra_interfaces(const uint8_t *desc, size_t len,
+                                            uint8_t interface_count)
+{
+    if (len > 0 && desc == NULL) return ESP_ERR_INVALID_ARG;
+    if (len > ESP_IRIS_USB_EXTRA_MAX_BYTES) return ESP_ERR_INVALID_SIZE;
+    if (interface_count > ESP_IRIS_USB_EXTRA_MAX_IFACES) return ESP_ERR_INVALID_SIZE;
+    if ((len == 0) != (interface_count == 0)) return ESP_ERR_INVALID_ARG;
+    if (len > 0) memcpy(s_extra_desc, desc, len);
+    s_extra_len = len;
+    s_extra_ifaces = interface_count;
+    return ESP_OK;
+}
+
+uint8_t esp_iris_usb_first_free_interface(void)
+{
+    return (uint8_t)(IRIS_USB_CDC_COUNT * 2);
+}
+
+/* Standard HID interface (9) + HID class descriptor (9) + IN endpoint (7) = 25
+ * bytes, written explicitly because TinyUSB's TUD_HID_DESCRIPTOR changes shape
+ * with CFG_TUD_HID_INOUT and would break this fixed offset table. Offsets below
+ * patch the interface number, report length, endpoint address/size/interval. */
+static const uint8_t s_hid_template[] = {
+    0x09, 0x04, 0x00, 0x00, 0x01, 0x03, 0x00, 0x00, 0x00, /* interface descriptor */
+    0x09, 0x21, 0x11, 0x01, 0x00, 0x01, 0x22, 0x00, 0x00, /* HID descriptor */
+    0x07, 0x05, 0x85, 0x03, 0x08, 0x00, 0x04,             /* IN endpoint */
+};
+#define IRIS_USB_HID_DESC_BYTES ((size_t)sizeof(s_hid_template))
+#define IRIS_USB_HID_OFF_ITF 2
+#define IRIS_USB_HID_OFF_REPORT_LEN 16
+#define IRIS_USB_HID_OFF_EP 20
+#define IRIS_USB_HID_OFF_EP_SIZE 22
+#define IRIS_USB_HID_OFF_INTERVAL 24
+_Static_assert(sizeof(s_hid_template) == 25, "unexpected HID descriptor layout");
+
+/* The table is copied: the caller's array is usually a stack object in
+ * app_main() and must not be referenced after registration. */
+static esp_iris_usb_hid_iface_t s_hid_iface_table[ESP_IRIS_USB_HID_MAX];
+static size_t s_hid_iface_count;
+static uint8_t s_config_fs[9 + IRIS_USB_CDC_COUNT * TUD_CDC_DESC_LEN +
+                           ESP_IRIS_USB_EXTRA_MAX_BYTES +
+                           ESP_IRIS_USB_HID_MAX * IRIS_USB_HID_DESC_BYTES];
+#if TUD_OPT_HIGH_SPEED
+static uint8_t s_config_hs[9 + IRIS_USB_CDC_COUNT * TUD_CDC_DESC_LEN +
+                           ESP_IRIS_USB_EXTRA_MAX_BYTES +
+                           ESP_IRIS_USB_HID_MAX * IRIS_USB_HID_DESC_BYTES];
+#endif
+
+esp_err_t esp_iris_usb_set_hid_ifaces(const esp_iris_usb_hid_iface_t *ifaces,
+                                      size_t count)
+{
+    if (count > 0 && ifaces == NULL) return ESP_ERR_INVALID_ARG;
+    if (count > ESP_IRIS_USB_HID_MAX) return ESP_ERR_INVALID_SIZE;
+    if (count > CFG_TUD_HID) return ESP_ERR_INVALID_STATE;
+    for (size_t i = 0; i < count; ++i) {
+        if (ifaces[i].report_desc == NULL || ifaces[i].report_desc_len == 0 ||
+            ifaces[i].ep_in == 0 || ifaces[i].ep_size == 0 ||
+            ifaces[i].interval_ms == 0) {
+            return ESP_ERR_INVALID_ARG;
+        }
+    }
+    memcpy(s_hid_iface_table, ifaces, count * sizeof(s_hid_iface_table[0]));
+    s_hid_iface_count = count;
+    return ESP_OK;
+}
+
+/* The configuration descriptor is composed at runtime by build_config(). */
+static const uint8_t s_cdc_fs[] = {
+    TUD_CDC_DESCRIPTOR(0, 4, 0x81, 8, 0x02, 0x82, 64),
+#if CONFIG_ESP_IRIS_DATA_LINK
+    TUD_CDC_DESCRIPTOR(2, 5, 0x83, 8, 0x04, 0x84, 64),
+#endif
+};
+#if TUD_OPT_HIGH_SPEED
+static const uint8_t s_cdc_hs[] = {
+    TUD_CDC_DESCRIPTOR(0, 4, 0x81, 8, 0x02, 0x82, 512),
+#if CONFIG_ESP_IRIS_DATA_LINK
+    TUD_CDC_DESCRIPTOR(2, 5, 0x83, 8, 0x04, 0x84, 512),
+#endif
+};
+#endif
+
+/* 9-byte configuration descriptor; total length and interface count are
+ * patched per build because the HID interface count is a runtime value. */
+static size_t build_config(uint8_t *buf, size_t cap, bool high_speed)
+{
+    const size_t total = 9 + IRIS_USB_CDC_COUNT * TUD_CDC_DESC_LEN + s_extra_len +
+                         s_hid_iface_count * IRIS_USB_HID_DESC_BYTES;
+    if (total > cap) return 0;
+
+    buf[0] = 9;
+    buf[1] = TUSB_DESC_CONFIGURATION;
+    buf[2] = (uint8_t)(total & 0xFF);
+    buf[3] = (uint8_t)(total >> 8);
+    buf[4] = (uint8_t)(IRIS_USB_CDC_COUNT * 2 + s_extra_ifaces + s_hid_iface_count);
+    buf[5] = 1;   /* bConfigurationValue */
+    buf[6] = 0;   /* iConfiguration */
+    buf[7] = 0x80; /* bmAttributes: reserved bit 7 set, bus powered */
+    buf[8] = 50;  /* bMaxPower: 100 mA in 2 mA units */
+
+    size_t off = 9;
+    memcpy(&buf[off], high_speed ? s_cdc_hs : s_cdc_fs,
+           IRIS_USB_CDC_COUNT * TUD_CDC_DESC_LEN);
+    off += IRIS_USB_CDC_COUNT * TUD_CDC_DESC_LEN;
+
+    /* Application block first: its interface numbers are fixed in the bytes the
+     * application built against esp_iris_usb_first_free_interface(). */
+    if (s_extra_len > 0) {
+        memcpy(&buf[off], s_extra_desc, s_extra_len);
+        off += s_extra_len;
+    }
+
+    uint8_t itf = (uint8_t)(IRIS_USB_CDC_COUNT * 2 + s_extra_ifaces);
+    for (size_t i = 0; i < s_hid_iface_count; ++i) {
+        const esp_iris_usb_hid_iface_t *h = &s_hid_iface_table[i];
+        memcpy(&buf[off], s_hid_template, sizeof(s_hid_template));
+        buf[off + IRIS_USB_HID_OFF_ITF] = itf++;
+        buf[off + IRIS_USB_HID_OFF_REPORT_LEN] = (uint8_t)(h->report_desc_len & 0xFF);
+        buf[off + IRIS_USB_HID_OFF_REPORT_LEN + 1] = (uint8_t)(h->report_desc_len >> 8);
+        buf[off + IRIS_USB_HID_OFF_EP] = h->ep_in;
+        buf[off + IRIS_USB_HID_OFF_EP_SIZE] = h->ep_size;
+        buf[off + IRIS_USB_HID_OFF_INTERVAL] = h->interval_ms;
+        off += sizeof(s_hid_template);
+    }
+    return off;
+}
+
 /* One USB stack, separate endpoints, decoders and link lifetimes. Only the
