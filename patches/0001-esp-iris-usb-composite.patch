+/* If the cable is plugged in after boot (or the host missed the first
+ * enumeration) TinyUSB can stay detached with no bus event to react to. Cycle
+ * the D+ pull-up so the host sees a fresh connect; harmless while no host is
+ * attached because nothing enumerates either way. */
+static void usb_hotplug_watchdog(void)
+{
+    static unsigned misses;
+    static TickType_t last_cycle;
+    if (atomic_load(&s_shutting_down)) return;
+    if (tud_mounted()) {
+        misses = 0;
+        return;
+    }
+    if (tud_suspended()) {
+        misses = 0;
+        return;
+    }
+    if (++misses < 200) return; /* ~2 s at the transport poll period */
+    const TickType_t now = xTaskGetTickCount();
+    if (last_cycle != 0 && (TickType_t)(now - last_cycle) < pdMS_TO_TICKS(5000)) return;
+    misses = 0;
+    last_cycle = now;
+    tud_disconnect();
+    vTaskDelay(pdMS_TO_TICKS(50));
+    tud_connect();
+    ESP_LOGI("iris_usb", "USB re-enumeration forced (no host mounted)");
+}
+
 static iris_link_event_t usb_poll(iris_runtime_t *runtime, iris_transport_state_t *state)
 {
     if (atomic_load(&s_shutting_down)) return IRIS_LINK_EVENT_NONE;
+    usb_hotplug_watchdog();
     const unsigned itf = interface_for(runtime);
     taskENTER_CRITICAL(&s_link_lock);
     const uint32_t generation = s_link[itf].generation;
